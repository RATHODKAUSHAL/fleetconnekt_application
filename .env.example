# Laravel API base URL. On a phone, use your computer's LAN IP (not 127.0.0.1).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Public website, used to open transporter listings from the Home screen.
EXPO_PUBLIC_SITE_URL=https://fleetconnekt.com

# Optional: Google Places key so booking city search can find cities not saved yet.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
