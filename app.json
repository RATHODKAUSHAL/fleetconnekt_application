{
  "expo": {
    "name": "FleetConnekt",
    "slug": "FleetConnekt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/App-Images/logo.png",
    "scheme": "comfleetconnektapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.fleetconnekt.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/App-Images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14253D",
          "image": "./assets/images/App-Images/logo.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3e35b12-ac1e-4f16-80ca-5d941ad0b5fa"
      }
    }
  }
}
